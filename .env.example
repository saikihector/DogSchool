POSTGRES_PORT=5432
POSTGRES_DB=db_dogschool
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-your-local-password
SESSION_SECRET=substitua-por-um-segredo-aleatorio-longo
FRONTEND_PORT=8080
FRONTEND_ORIGIN=http://localhost:8080

COOKIE_SECURE=false

# Recuperação de senha: Mailpit é apenas para testes locais.
EMAIL_PROVIDER=mailpit
PUBLIC_BASE_URL=http://localhost:8080
